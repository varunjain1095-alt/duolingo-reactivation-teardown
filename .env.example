# ==============================================================================
# Duolingo Reactivation Engine — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your real credentials.
# ==============================================================================

# 1. PostHog Analytics Platform (Tables 1–4, Event Ingestion & Feature Flags)
POSTHOG_API_KEY=phc_your_posthog_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=phx_your_personal_management_api_key_here
POSTHOG_PROJECT_ID=your_posthog_project_id_here

# 2. Supabase PostgreSQL Database (Table 5: Feature Definitions & Mutations)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 3. Decision Engine Backend API Service (FastAPI)
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# 4. Frontend Client SDK & Overlay Configuration
VITE_REACTIVATION_API_URL=http://localhost:8000/api/v1/reactivation
REACT_APP_REACTIVATION_API_URL=http://localhost:8000/api/v1/reactivation
